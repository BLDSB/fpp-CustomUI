# Copy this file to .env and fill in each value before starting the app.
# Never commit .env to source control.

# Base URL for the FPP REST API (no trailing slash)
FPP_BASE_URL=http://localhost/api

# Flask secret key — generated automatically at install time
SECRET_KEY=replace-with-a-strong-random-value

# Bcrypt-hashed admin PIN. Left empty on a fresh install — the controller then
# serves the first-run setup page, where the first visitor on the local network
# chooses a 4-digit PIN. Clear this (and MASTER_PIN_HASH) to re-run setup.
ADMIN_PASSWORD_HASH=

# Bcrypt-hashed master PIN. Optional — set from the Settings page. Always works
# even if the admin PIN is changed.
MASTER_PIN_HASH=

# Secret token for the /internal/* endpoints called by FPP playlists.
# Generated automatically at install time.
INTERNAL_TOKEN=

# Public URL path for this install, e.g. UI_PATH=cityname serves the UI at
# http://<pi-ip>/cityname. Set from the first-run setup page, the Settings
# page, or `sudo fpp-ui-set-path <name>`. Preserved across upgrades.
UI_PATH=CustomUI
