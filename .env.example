# Copy this file to .env and fill in each value before starting the app.
# Never commit .env to source control.

# Base URL for the FPP REST API (no trailing slash)
FPP_BASE_URL=http://localhost/api

# Flask secret key — generated automatically at install time
SECRET_KEY=replace-with-a-strong-random-value

# Bcrypt-hashed admin PIN. Left empty on a fresh install — the controller then
# serves the first-run setup page, where the first visitor on the local network
# chooses a 4-digit PIN. Clear this to re-run setup.
ADMIN_PASSWORD_HASH=

# Bcrypt-hashed master PIN. Generated at install time by fpp_install.sh (the PIN
# is shown once on the installer's final banner). Always works, even if the admin
# PIN is changed. Only a master-PIN login can change it (Settings page); it is
# not included in backups.
MASTER_PIN_HASH=

# Secret token for the /internal/* endpoints called by FPP playlists.
# Generated automatically at install time.
INTERNAL_TOKEN=

# Public URL path for this install, e.g. UI_PATH=cityname serves the UI at
# http://<pi-ip>/cityname. Set from the first-run setup page, the Settings
# page, or `sudo fpp-ui-set-path <name>`. Preserved across upgrades.
UI_PATH=CustomUI

# Optional overrides (defaults shown). Leave commented unless this install
# needs something different.
# SQLAlchemy database URL; the default keeps the SQLite file in instance/.
# DATABASE_URL=sqlite:///fpp_ui.db
# FPP's media directory (sequences, audio, config). Backup/restore reads it.
# FPP_MEDIA_ROOT=/home/fpp/media
# Extra host[:port] values allowed to POST to the UI (comma-separated). Only
# needed behind a proxy that rewrites both Host and X-Forwarded-Host.
# TRUSTED_ORIGINS=
